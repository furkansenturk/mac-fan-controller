// Settings shared by every target. Project-level base configuration.

// MARK: Identity

BUNDLE_ID_PREFIX = com.furkansenturk
APP_BUNDLE_ID = $(BUNDLE_ID_PREFIX).FanController
HELPER_BUNDLE_ID = $(APP_BUNDLE_ID).Helper

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 0.1.0.2

// MARK: Platform

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0

// MARK: Signing
// Builds are signed to run locally by default. Copy Signing.example.xcconfig to
// Signing.xcconfig and set your Team ID to sign with your own certificate.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = YES
// Keeps get-task-allow out of Release builds, which the helper requires of its client.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// MARK: Build

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
COPY_PHASE_STRIP = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

ONLY_ACTIVE_ARCH[config=Debug] = YES
ENABLE_TESTABILITY[config=Debug] = YES
DEBUG_INFORMATION_FORMAT[config=Debug] = dwarf
DEBUG_INFORMATION_FORMAT[config=Release] = dwarf-with-dsym
SWIFT_OPTIMIZATION_LEVEL[config=Debug] = -Onone
SWIFT_OPTIMIZATION_LEVEL[config=Release] = -O
SWIFT_COMPILATION_MODE[config=Release] = wholemodule
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = DEBUG
GCC_PREPROCESSOR_DEFINITIONS[config=Debug] = DEBUG=1
ENABLE_NS_ASSERTIONS[config=Release] = NO
VALIDATE_PRODUCT[config=Release] = YES

#include? "Signing.xcconfig"
