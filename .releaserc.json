{
  "branches": ["main", { "name": "beta", "prerelease": true }],
  "tagFormat": "v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to this project are documented here. Entries are generated by [semantic-release](https://semantic-release.gitbook.io) from [Conventional Commits](https://www.conventionalcommits.org), and the project uses [Semantic Versioning](https://semver.org/)."
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "Scripts/set-version.sh ${nextRelease.version} && Scripts/build-release.sh"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "Config/Base.xcconfig"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/FanController-*.zip", "label": "FanController.app (macOS 14 or later)" },
          { "path": "dist/FanController-*.zip.sha256", "label": "SHA-256 checksum" }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
